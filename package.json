{
  "name": "swagger-ui-cli",
  "version": "0.0.13",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "swagger-ui-cli": "dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node esbuild.config.js && tsc --emitDeclarationOnly -p ./tsconfig.app.json --outDir ./dist",
    "format": "prettier --write '**/*.{html,js,json,md,scss,ts}'",
    "format:check": "prettier --check '**/*.{html,js,json,md,scss,ts}'",
    "lint": "eslint . --ext .js,.ts --fix",
    "lint:check": "eslint . --ext .js,.ts",
    "test": "node --experimental-vm-modules --experimental-modules node_modules/jest/bin/jest.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szendezsombor/swagger-ui-cli.git"
  },
  "keywords": [],
  "author": "Zsombor Szende",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/szendezsombor/swagger-ui-cli/issues"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "public/**/*",
    "Readme.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/szendezsombor/swagger-ui-cli#readme",
  "description": "This is a CLI tool bundle your openapi documentation or serve for live editing.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^24.19.2",
    "@types/signale": "^1.4.7",
    "@types/swagger-ui": "^5.32.0",
    "cli-testing-library": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-image-snapshot": "^6.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.15.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "signale": "^1.4.0",
    "swagger-ui-dist": "^5.34.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
